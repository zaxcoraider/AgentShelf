# PayPal (sandbox only): Developer Dashboard → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Sandbox test logins (reference only; not read by the app)
SANDBOX_SELLER_EMAIL=
SANDBOX_SELLER_PASSWORD=
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# AI gateway (DGrid AI, OpenAI-compatible)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_AGENT=        # strong tool calling (e.g. a Claude model)
AI_MODEL_VISION=       # photo → listing
AI_MODEL_FAST=         # NL → grid filter, short answers

# Optional fallback provider (any OpenAI-compatible endpoint)
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

APP_URL=http://localhost:3000
# Empty = local embedded Postgres (PGlite in .data/). Set a postgres:// URL on Render.
DATABASE_URL=
