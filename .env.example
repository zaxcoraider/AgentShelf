# PayPal (sandbox only): Developer Dashboard → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Sandbox test logins (reference only; not read by the app)
SANDBOX_SELLER_EMAIL=
SANDBOX_SELLER_PASSWORD=
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# AI gateway (DGrid AI, OpenAI-compatible)
AI_BASE_URL=
AI_API_KEY=
# Tested on Nebius Token Factory (AI_BASE_URL=https://api.tokenfactory.nebius.com/v1/), Oct 2026:
AI_MODEL_AGENT=        # strong tool calling, e.g. deepseek-ai/DeepSeek-V4.1-Flash-1017
AI_MODEL_VISION=       # photo → listing, e.g. moonshotai/Kimi-K3
AI_MODEL_FAST=         # short grounded answers, e.g. deepseek-ai/DeepSeek-V4.1-Flash-1017

# Optional fallback provider (any OpenAI-compatible endpoint)
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Password for the seller pages (/seller/*). Leave empty locally to skip sign-in; always set it when hosted.
SELLER_DEMO_PASSWORD=

APP_URL=http://localhost:3000
# Empty = local embedded Postgres (PGlite in .data/). Set a postgres:// URL on Render.
DATABASE_URL=

# AG Studio (seller dashboard). Optional: without a key it runs with a watermark.
AG_STUDIO_LICENSE_KEY=

# Optional: Channel3 (trychannel3.com) market prices when adding products from a photo
CHANNEL3_API_KEY=
# Optional: signing secret of the Channel3 webhook endpoint (/api/webhooks/channel3) for Market watch price alerts
CHANNEL3_WEBHOOK_SECRET=
