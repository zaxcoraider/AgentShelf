{
  "name": "agentshelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:ai": "tsx --env-file=.env scripts/smoke-ai.mts",
    "smoke:paypal": "tsx --env-file=.env scripts/smoke-paypal.mts",
    "smoke:agent": "tsx --env-file=.env scripts/smoke-agent.mts",
    "smoke:seller-agent": "tsx --env-file-if-exists=.env scripts/smoke-seller-agent.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.mts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "smoke:mcp": "tsx --env-file-if-exists=.env scripts/smoke-mcp.mts",
    "smoke:webhook": "tsx --env-file-if-exists=.env scripts/smoke-webhook.mts",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@electric-sql/pglite": "^0.5.13",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "ai": "^7.0.155",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
